# Example environment for reference-architecture/docker-compose.yml — EXAMPLE ONLY.
# Not used by the main app (../src); the Vite/React dashboard needs no environment variables at all.
# Copy to .env in this folder only if you actually build out the ingestion/ service referenced
# in docker-compose.yml. None of the values below are real credentials.

# --- TimescaleDB ---
POSTGRES_USER=keedian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keedian_site01

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Site identity (passed to the ingestion service) ---
SITE_ID=site01
